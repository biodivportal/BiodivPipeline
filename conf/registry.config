/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEMPORARY registry override — pull module images from a public personal namespace
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The module `container` directives point at the canonical ghcr.io/biodivportal/<module>
    images. Those org packages are private and cannot yet be made public (needs org
    admin), so anonymous pulls fail and the pipeline would not run on a fresh machine.

    Until the biodivportal packages are published AND set Public, they are mirrored to
    the public namespace ghcr.io/mitchell7970/<module> and this file remaps every
    module's container to that mirror. It is loaded by default from nextflow.config.

    TO REVERT (once ghcr.io/biodivportal/* is public): delete this file and remove the
    `includeConfig 'conf/registry.config'` line from nextflow.config. The module
    `container` directives already carry the correct canonical refs.
----------------------------------------------------------------------------------------
*/

process {
    withName: COLUMN_STANDARDISE   { container = 'ghcr.io/mitchell7970/column-standardise:0.1' }
    withName: BIODIV_ANNOTATE      { container = 'ghcr.io/mitchell7970/biodiv-annotate:0.1' }
    withName: TAXONOMY_CLASSIFY    { container = 'ghcr.io/mitchell7970/taxonomy-classify:0.1' }
    withName: OUTLIER_DETECT       { container = 'ghcr.io/mitchell7970/outlier-detect:0.1' }
    withName: PROVISIONAL_CONCEPTS { container = 'ghcr.io/mitchell7970/provisional-concepts:0.1' }
    withName: ASSEMBLE_DATASET     { container = 'ghcr.io/mitchell7970/assemble-dataset:0.1' }
    withName: COLLECT_REPORTS      { container = 'ghcr.io/mitchell7970/collect-reports:0.1' }
    withName: RDF_TRANSFORM        { container = 'ghcr.io/mitchell7970/rdf-matching-and-transformation-service:0.1' }
}
