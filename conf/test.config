/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as:  nextflow run main.nf -profile test,docker --outdir results
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources for CI (legacy params for maximum compatibility)
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    input          = "${projectDir}/data/sample.csv"
    mapping_schema = "${projectDir}/assets/default_mapping.jsonld"
    outdir         = "${projectDir}/results"

    // LLM endpoint for WP3 taxonomy_classify. Uses real OpenAI with the land_cover key.
    // Requires the WP3_OPENAI_API_KEY Nextflow secret to hold the (OpenAI) land_cover key.
    taxonomy_llm_base_url = ''             // empty -> default OpenAI endpoint
    taxonomy_llm_model    = 'gpt-4o-mini'
}

process {
  resourceLimits = [
    cpus: 2,
    memory: 6.GB,
    time: 6.h
  ]
}
