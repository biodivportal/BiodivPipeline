/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local-testing container overrides
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    For running the pipeline against locally-built module images while the demo
    images live in personal / private registries we cannot all pull from.

    Build the image(s) locally, then pass this file with `-c`, e.g.:

        docker build --platform linux/amd64 \
            -t wp5-provisional-concepts:local \
            modules/local/provisional_concepts/bin

        nextflow run main.nf -profile test,docker,emulate_amd64 \
            -c conf/local_images.config --outdir results

    Only the overridden processes change; everything else uses the containers
    declared in each module's main.nf. Not committed as a default profile — this
    is a per-developer local aid.
----------------------------------------------------------------------------------------
*/

process {
    withName: PROVISIONAL_CONCEPTS {
        container = 'wp5-provisional-concepts:local'
    }

    // If you also build WP3/WP4 locally from their Dockerfiles, uncomment:
    // withName: TAXONOMY_CLASSIFY { container = 'wp3-taxonomy-classify:local' }
    // withName: OUTLIER_DETECT    { container = 'wp4-outlier-detect:local' }
}
