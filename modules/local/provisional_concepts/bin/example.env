# OpenAI-Compatible LLM Configuration
# To use Gemini via OpenAI compatibility layer:
WP5_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
WP5_LLM_MODEL=gemini-3.1-flash-lite
WP5_OPENAI_API_KEY=YOUR_GEMINI_API_KEY


# To switch back to a local LM Studio server, uncomment below:
# WP5_LLM_BASE_URL=http://localhost:1234/v1
# WP5_LLM_MODEL=local-model
# WP5_OPENAI_API_KEY=lm-studio

# RPM implementation (default here is for free gemini API)
WP5_LLM_RPM=15

# --- OpenAI Batch API (optional; defaults to true) --------------------------
# Set WP5_LLM_USE_BATCH=true to route run_llm_batch (and therefore split_locality_label /
# the locality resolver) through the OpenAI Batch API. Set to false to run synchronously.
# Reuses WP5_LLM_BASE_URL, WP5_OPENAI_API_KEY and WP5_LLM_MODEL.
WP5_LLM_USE_BATCH=true
