  "barcode": {
    "abcd_term": "ID",
    "type": "regex",
    "pattern": "^[A-Z]{1,3}(\\s*\\d+)+$"
  },
  "herbarium_id": {
    "abcd_term": "SourceInstitutionID",
    "type": "composite",
    "base_pattern": "^[A-Z]{1,3}\\d{6,}$",
    "multiply_by_uniqueness": true
  },
  "collector_number": {
    "abcd_term": "hasFieldNumber",
    "type": "regex",
    "pattern": "^(s\\.n\\.|\\d+[a-zA-Z]?|[A-Z]?\\d{1,6})$"
  },
  "identifier_agent": {
    "abcd_term": "hasIdentifier",
    "type": "regex",
    "pattern": "^([A-Z]\\.\\s*)+[A-Z\u00c4\u00d6\u00dca-z\u00e4\u00f6\u00fc\u00df\\-]+$|^[A-Z][a-z]+ [A-Z][a-z\u00e4\u00f6\u00fc\u00df]+$"
  },
  "collector_name": {
    "abcd_term": "hasGatheringAgent",
    "type": "regex",
    "pattern": "^[A-Z\u00c4\u00d6\u00dca-z\u00e4\u00f6\u00fc\u00df\\-]+,[A-Z\u00c4\u00d6\u00dca-z\u00e4\u00f6\u00fc\u00df\\s\\.]+$"
  },
  "free_text": {
    "abcd_term": "Text",
    "type": "text_metrics",
    "length_divisor": 80,
    "require_spaces": true
  },
  "notes": {
    "abcd_term": "Notes",
    "type": "text_metrics",
    "length_divisor": 40,
    "require_spaces": true,
    "uniqueness_multiplier": 2,
    "missingness_multiplier": 3
  },
  "source_institution": {
    "abcd_term": "SourceInstitutionID",
    "type": "composite",
    "base_pattern": "^[A-Z]{2,10}$",
    "few_values_threshold": 5,
    "few_values_penalty_divisor": 20
  },
  "habitat": {
    "abcd_term": "hasBiotope",
    "type": "composite",
    "keyword_regex": "\\b(forest|wald|wiese|meadow|bog|moor|steppe|grassland|shrub|coast|ufer|hang|slope|wetland|heath|heide|alpine|subalpine|riverbank|floodplain|savanna|desert|tundra|woodland|swamp|marsh|jungle|rainforest|lake|river|stream|ocean|sea|beach|dune|mountain|valley|cave|reef|coral|urban|city|park|garden|field|pasture|prairie|taiga|chaparral|mangrove|estuary|geh\u00f6lz|sumpf|marsch|dschungel|regenwald|see|fluss|bach|meer|ozean|strand|d\u00fcne|berg|tal|h\u00f6hle|riff|stadt|garten|feld|weide|pr\u00e4rie)\\b",
    "ignore_case": true,
    "length_divisor": 40,
    "require_spaces": true,
    "base_weight": 0.4,
    "keyword_weight": 0.6
  },
  "expedition_text": {
    "abcd_term": "hasProject",
    "type": "composite",
    "keyword_regex": "\\b(\\d{4}|expedition|reise|trip|exped\\.|sammlung|tour|collection|survey|journey|voyage|campaign|exploration|mission|cruise|fahrt|exkursion|forschung|kampagne|coll\\.|leg\\.)\\b",
    "ignore_case": true,
    "length_divisor": 30,
    "require_spaces": true,
    "uniqueness_threshold": 0.3,
    "uniqueness_below_weight": 1.0,
    "uniqueness_above_weight": 0.4,
    "base_weight": 0.3,
    "keyword_weight": 0.7
  }
}