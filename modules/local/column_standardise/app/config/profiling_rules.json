{
  "latitude": {
    "abcd_term": "LatitudeDecimal",
    "type": "numeric",
    "min": -90,
    "max": 90,
    "hint_min": 30,
    "hint_max": 75,
    "hint_weight": 1.3,
    "fallback_weight": 0.6
  },
  "longitude": {
    "abcd_term": "LongitudeDecimal",
    "type": "numeric",
    "min": -180,
    "max": 180,
    "hint_min": -30,
    "hint_max": 30,
    "hint_weight": 1.3,
    "fallback_weight": 0.6
  },
  "url": {
    "abcd_term": "ResourceURI",
    "type": "regex",
    "pattern": "^https?://"
  },
  "multimedia_url": {
    "abcd_term": "FileURL",
    "type": "regex",
    "pattern": "^https?://.*(iiif|/image/|/media/|/foto/|/img/|/pictures?/|/videos?/|/audio/|/assets/|/multimedia/|\\.(jpg|jpeg|png|gif|svg|webp|mp4|webm|mp3|wav|ogg))",
    "ignore_case": true
  },
  "map_link": {
    "abcd_term": "hasCoordinates",
    "type": "regex",
    "pattern": "^https?://.*(maps?|geo|coord|lat|lon|leaflet|openstreetmap|google.*maps|bing.*maps|apple.*maps|mapbox|carto|esri|arcgis|gis|wms|wmts|wfs|kml|geojson|spatial|location|routing|directions)",
    "ignore_case": true
  },
  "date": {
    "abcd_term": "hasDate",
    "type": "regex",
    "pattern": "^\\d{4}[-/]\\d{2}([-/]\\d{2})?$|^\\d{4}$|^\\d{2}\\.\\d{2}\\.\\d{4}$"
  },
  "date_begin": {
    "abcd_term": "TimeSpanBegin",
    "type": "composite",
    "base_rule": "date",
    "missingness_threshold": 0.3,
    "missingness_below_weight": 1.0,
    "missingness_above_weight": 0.3
  },
  "date_end": {
    "abcd_term": "TimeSpanEnd",
    "type": "composite",
    "base_rule": "date",
    "missingness_threshold": 0.6,
    "missingness_below_weight": 0.2,
    "missingness_above_weight": 1.3
  },
  "scientific_name": {
    "abcd_term": "FullScientificName",
    "type": "regex",
    "pattern": "^[A-Z][a-z]+ [a-z]+"
  },
